#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import os
import re
import sys

SCRIPTS_DIR = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(SCRIPTS_DIR))

from multilabelz.app import main

if __name__ == "__main__":
    sys.argv[0] = re.sub(r"(-script\.pyw|\.exe)?$", "", sys.argv[0])
    sys.exit(main())
